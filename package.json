{
  "name": "trime-theme-editor",
  "private": true,
  "version": "0.3.0",
  "description": "A self-contained Trime theme authoring tool that compiles typed presets into a single trime.yaml.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jvcon/trime-theme-editor.git"
  },
  "homepage": "https://github.com/Jvcon/trime-theme-editor#readme",
  "bugs": {
    "url": "https://github.com/Jvcon/trime-theme-editor/issues"
  },
  "keywords": [
    "rime",
    "trime",
    "theme",
    "editor",
    "keyboard",
    "react",
    "vite",
    "cloudflare-workers"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
